# Google Cloud TTS — Indic / Hindi mantra playback (hi-IN voices)
# Enable "Cloud Text-to-Speech API" in Google Cloud Console for the same project as this key.
# Also loaded from repo root `.env` if set there.
# GOOGLE_CLOUD_TTS_API_KEY=
# Optional tuning:
# GOOGLE_TTS_LANGUAGE_CODE=hi-IN
# GOOGLE_TTS_VOICE_NAME=hi-IN-Neural2-D
# GOOGLE_TTS_VOICE_FALLBACKS=hi-IN-Wavenet-A
# GOOGLE_TTS_SPEAKING_RATE=0.92
# GOOGLE_TTS_MANTRA_SPEAKING_RATE=0.88
# GOOGLE_TTS_TAIL_BREAK_MS=160

# Firestore — required for seed_sutras.py and dynamic catalog on API
# Firebase Console → Project settings → Service accounts → Generate new private key
# Save the file as firebase-service-account.json in this folder (add to .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Alternative (same file path):
# GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
