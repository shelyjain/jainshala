{
  "expo": {
    "name": "Jain Shala",
    "slug": "jain-shala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jain-shala-logo.png",
    "scheme": "jainshala",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jainshala.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Used to check your recitation of Jain sutras.",
        "NSMicrophoneUsageDescription": "Used to listen to your recitation.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jainshala.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jain-shala-logo.png",
        "backgroundColor": "#fdf8f4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/jain-shala-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/jain-shala-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fdf8f4",
          "dark": {
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27eeeca7-31f6-4d07-8403-462ba2c9d794"
      }
    }
  }
}
