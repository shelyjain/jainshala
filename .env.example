# Copy to `.env` and fill in from Firebase Console:
# Project settings → Your apps → Web app → SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: FastAPI backend (physical device / custom host)
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000

# Google Sign-In (native). Web uses Firebase popup — enable Google in Firebase Console → Authentication.
# Web client ID: Firebase Console → Project settings → Your apps → Web app, or Authentication → Google → Web SDK.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
