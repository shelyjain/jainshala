rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.roles != null
        && userDoc().data.roles.hasAny(['admin']);
    }

    function rolesUnchanged() {
      return !('roles' in request.resource.data)
        || request.resource.data.roles == resource.data.roles;
    }

    match /sutras/{sutraId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        (request.auth.uid == userId && rolesUnchanged())
        || isAdmin()
      );
      allow delete: if false;
    }
  }
}
